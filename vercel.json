{
  "installCommand": "npm run install:all",
  "buildCommand": "npm run build",
  "outputDirectory": "Geoportal-aburra/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/routes/foot"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
